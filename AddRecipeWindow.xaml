<Window x:Class="RecipeManager.AddRecipeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Recipe" Height="550" Width="400">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/adding ingredients.jpg"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10">
            <TextBlock Text="Recipe Name:" FontSize="16" Foreground="White"/>
            <TextBox x:Name="RecipeNameTextBox" Margin="5"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="10">
            <TextBlock Text="Ingredients:" FontSize="16" Foreground="White"/>
            <Button x:Name="AddIngredientButton" Content="Add Ingredient" Click="AddIngredientButton_Click" Margin="5"/>
            <ListBox x:Name="IngredientsListBox" Margin="5" Height="100"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="10">
            <TextBlock Text="Steps:" FontSize="16" Foreground="White"/>
            <TextBox x:Name="StepTextBox" Margin="5"/>
            <Button x:Name="AddStepButton" Content="Add Step" Click="AddStepButton_Click" Margin="5"/>
            <ListBox x:Name="StepsListBox" Margin="5" Height="100"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button x:Name="SaveRecipeButton" Content="Save" Click="SaveRecipeButton_Click" Margin="5"/>
            <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
