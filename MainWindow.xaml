<Window x:Class="RecipeManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recipe Manager" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Recipe-Management-3.jpg"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Fortune's Recipe Manager" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="10" TextAlignment="Center" Foreground="White"/>

        <ListBox x:Name="RecipesListBox" Grid.Row="1" Grid.Column="0" Margin="10" SelectionChanged="RecipesListBox_SelectionChanged" Foreground="White" Background="Transparent"/>

        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10">
            <Button x:Name="AddRecipeButton" Content="Add Recipe" Click="AddRecipeButton_Click" Foreground="White" Background="Transparent" Width="370"/>
            <Button x:Name="DisplayRecipesButton" Content="Display Recipes" Click="DisplayRecipesButton_Click" Margin="5" Foreground="White" Background="Transparent" Width="370"/>
            <Button x:Name="ScaleRecipeButton" Content="Scale Recipe" Click="ScaleRecipeButton_Click" Margin="5" Foreground="White" Background="Transparent" Width="370"/>
            <Button x:Name="ResetQuantitiesButton" Content="Reset Quantities" Click="ResetQuantitiesButton_Click" Margin="5" Foreground="White" Background="Transparent" Width="370"/>
            <Button x:Name="ClearDataButton" Content="Clear Data" Click="ClearDataButton_Click" Margin="5" Foreground="White" Background="Transparent" Width="370"/>
            <Button x:Name="ExitButton" Content="Exit" Click="ExitButton_Click" Margin="5" Foreground="White" Background="Transparent" Width="370"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <TextBlock Text="Filter by Ingredient:" VerticalAlignment="Center" Margin="5" Foreground="White"/>
            <TextBox x:Name="FilterTextBox" Width="150" Margin="5"/>
            <TextBlock Text="Food Group:" VerticalAlignment="Center" Margin="5" Foreground="White"/>
            <ComboBox x:Name="FoodGroupComboBox" Width="150" Margin="5">
                <ComboBoxItem Content="All" IsSelected="True"/>
                <ComboBoxItem Content="Fruits"/>
                <ComboBoxItem Content="Vegetables"/>
                <ComboBoxItem Content="Protein"/>
                <ComboBoxItem Content="Dairy"/>
                <ComboBoxItem Content="Grains"/>
            </ComboBox>
            <TextBlock Text="Max Calories:" VerticalAlignment="Center" Margin="5" Foreground="White"/>
            <TextBox x:Name="MaxCaloriesTextBox" Width="150" Margin="5"/>
            <Button x:Name="FilterButton" Content="Filter" Click="FilterButton_Click" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
