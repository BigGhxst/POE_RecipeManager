<Window x:Class="RecipeManager.AddIngredientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Ingredient" Height="350" Width="300" >
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/ingredients.jpg"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10">
            <TextBlock Text="Ingredient Name:" FontSize="16" Foreground="White"/>
            <TextBox x:Name="IngredientNameTextBox" Margin="5"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="10">
            <TextBlock Text="Quantity:" FontSize="16" Foreground="White"/>
            <TextBox x:Name="QuantityTextBox" Margin="5"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="10">
            <TextBlock Text="Unit of Measurement:" FontSize="16" Foreground="White"/>
            <TextBox x:Name="UnitTextBox" Margin="5"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="10">
            <TextBlock Text="Number of Calories:" FontSize="16" Foreground="White"/>
            <TextBox x:Name="CaloriesTextBox" Margin="5"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="10">
            <TextBlock Text="Food Group:" FontSize="16" Foreground="White"/>
            <TextBox x:Name="FoodGroupTextBox" Margin="5"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button x:Name="SaveIngredientButton" Content="Save" Click="SaveIngredientButton_Click" Margin="5"/>
            <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
