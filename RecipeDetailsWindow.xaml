<Window x:Class="RecipeManager.RecipeDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recipe Details" Height="450" Width="400">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/adding.jpg"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10">
            <StackPanel.Background>
                <ImageBrush/>
            </StackPanel.Background>
            <TextBlock Text="Recipe Details" FontSize="16" FontWeight="Bold" Margin="5" Foreground="White"/>
            <TextBlock x:Name="RecipeNameTextBlock" FontSize="14" Margin="5" Foreground="White"/>
            <TextBlock Text="Ingredients:" FontSize="14" FontWeight="Bold" Margin="5" Foreground="White"/>
            <ListBox x:Name="IngredientsListBox" Margin="5" Height="100">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding IsCompleted}" Margin="5"/>
                            <TextBlock Text="{Binding Name}" FontSize="14" Margin="5"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="Steps:" FontSize="14" FontWeight="Bold" Margin="5" Foreground="White"/>
            <ListBox x:Name="StepsListBox" Margin="5" Height="100">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding IsCompleted}" Margin="5"/>
                            <TextBlock Text="{Binding Description}" FontSize="14" Margin="5"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="TotalCaloriesTextBlock" FontSize="14" FontWeight="Bold" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
